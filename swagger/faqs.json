[
  {
    "path": "/",
    "method": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "get faq data",
        "parameters": [
          {
            "in": "query",
            "name": "category",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "intent",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "language_id",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "is_active",
            "schema": {
              "nullable": true,
              "type": "boolean",
              "enum": [true, false]
            }
          },
          {
            "in": "query",
            "name": "created_at",
            "schema": {
              "type": "date"
            }
          },
          {
            "in": "query",
            "name": "created_by",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "updated_at",
            "schema": {
              "type": "date"
            }
          },
          {
            "in": "query",
            "name": "updated_by",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "start",
            "schema": {
              "type": "timestamp"
            }
          },
          {
            "in": "query",
            "name": "end",
            "schema": {
              "type": "timestamp"
            }
          }
        ]
      },
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "create new faq data",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "category": {
                    "type": "string",
                    "default": ""
                  },
                  "intent": {
                    "type": "string",
                    "default": ""
                  },
                  "language_id": {
                    "type": "integer",
                    "default": ""
                  }
                },
                "required": ["category", "intent", "language_id"]
              }
            }
          }
        }
      }
    }
  },
  {
    "path": "/{id}",
    "method": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "get faq data by id",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "integer"
            },
            "required": true
          }
        ]
      },
      "put": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "update existing faq data by id",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "integer"
            },
            "required": true
          }
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "category": {
                    "type": "string",
                    "default": ""
                  },
                  "intent": {
                    "type": "string",
                    "default": ""
                  },
                  "language_id": {
                    "type": "integer",
                    "default": ""
                  },
                  "is_active": {
                    "type": "boolean",
                    "default": "",
                    "enum": [true, false]
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  {
    "path": "/import",
    "method": {
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "import faq data",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "must be .xlsx"
                  }
                },
                "required": ["file"]
              }
            }
          }
        }
      }
    }
  },
  {
    "path": "/train",
    "method": {
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "train network from faq data"
      }
    }
  }
]
